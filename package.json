{
  "name": "icaiming",
  "type": "module",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "admin": "tsx scripts/admin/server.ts",
    "dev:ui": "astro dev",
    "content:sync": "tsx scripts/content.ts",
    "content:check": "tsx scripts/content.ts --check",
    "content:publish": "tsx scripts/content.ts --publish",
    "build": "astro build",
    "preview": "wrangler dev",
    "check": "astro check && tsc --noEmit -p tsconfig.workers.json",
    "test": "tsx --test tests/*.test.ts",
    "test:local": "tsx scripts/verify-local.ts",
    "aggregator:dev": "wrangler dev --config workers/aggregator/wrangler.toml",
    "aggregator:deploy": "wrangler deploy --config workers/aggregator/wrangler.toml"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/tailwind": "^6.0.2",
    "@cloudflare/workers-types": "4.20251011.0",
    "@types/node": "^22.18.6",
    "astro": "^5.14.1",
    "gsap": "^3.15.0",
    "nanostores": "^1.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwindcss": "^3.4.17",
    "three": "^0.186.1",
    "typescript": "^5.9.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.0",
    "@types/hast": "^3.0.4",
    "@types/three": "^0.186.0",
    "aws4fetch": "^1.0.20",
    "chokidar": "^4.0.3",
    "miniflare": "4.20251011.1",
    "tsx": "^4.20.6",
    "undici": "7.14.0",
    "wrangler": "4.45.0"
  }
}
