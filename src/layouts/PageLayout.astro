---
import BaseLayout from './BaseLayout.astro';
interface Props { title: string; eyebrow: string; english: string; description: string; section: string }
const { title, eyebrow, english, description, section } = Astro.props;
---
<BaseLayout title={`${title} — IC Aiming`} description={description} section={section}>
  <main id="main" class="shell"><header class="page-head"><p class="eyebrow">{eyebrow}</p><h1>{title}<span class="english"> / {english}</span></h1><p class="description">{description}</p></header><div class="content-area"><slot /></div></main>
</BaseLayout>
