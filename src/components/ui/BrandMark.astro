---
interface Props {
  class?: string;
  variant?: 'full' | 'compact';
}
const { class: className, variant = 'full' } = Astro.props;
---
<svg class={className} viewBox={variant === 'compact' ? '20 19 80 80' : '0 0 120 120'} fill="none" aria-hidden="true" focusable="false" data-brand-mark={variant}>
  {variant === 'full' && <g data-brand-frame>
    <path d="M94 26A48 48 0 1 0 94 94" stroke="currentColor" stroke-width="6" />
    <path d="M103 47H109V73H103Z" fill="currentColor" />
  </g>}
  <g fill="currentColor" data-brand-monogram>
    <path d="M60 27 32 73H45L60 48 75 73H88Z" />
    <path d="M34 79H45L49 84 60 72 71 84 75 79H86L71 95 60 83 49 95Z" />
  </g>
</svg>
<style>
  svg { display: block; flex-shrink: 0; }
</style>
