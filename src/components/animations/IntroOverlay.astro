---
import BrandMark from '../ui/BrandMark.astro';
// Full-screen opening sequence for the home page. Hidden by CSS unless IntroGate set data-intro="play".
---
<div class="intro" data-intro-root role="region" aria-label="开场动画">
  <canvas class="intro-canvas" data-intro-canvas aria-hidden="true"></canvas>
  <div class="intro-grid" data-intro-grid aria-hidden="true"></div>
  <div class="intro-vignette" data-intro-vignette aria-hidden="true"></div>
  <div class="intro-reticle" data-intro-reticle aria-hidden="true"><i></i><i></i><i></i><i></i></div>
  <div class="intro-lite" aria-hidden="true">
    <span class="intro-lite-ring"></span>
    <span class="intro-lite-ring is-inner"></span>
    <BrandMark class="intro-lite-mark" />
  </div>
  <div class="intro-flash" data-intro-flash aria-hidden="true"></div>
  <div class="intro-tagline" data-intro-tagline aria-hidden="true">
    <p class="intro-tagline-en"><span data-tagline-part style="--i:0">Stay cool.</span> <span data-tagline-part style="--i:1">See clearly.</span> <span data-tagline-part class="is-accent" style="--i:2">Keep aiming.</span></p>
    <span class="intro-tagline-rule" data-tagline-part style="--i:3"></span>
    <p class="intro-tagline-zh" data-tagline-part style="--i:4">冷静观察 · 持续瞄准</p>
  </div>
  <div class="intro-hud mono" data-intro-hud aria-hidden="true">
    <span class="intro-corner is-tl"></span><span class="intro-corner is-tr"></span><span class="intro-corner is-bl"></span><span class="intro-corner is-br"></span>
    <span class="intro-hud-label is-tl">IC AIMING <i>/ EST. 2026</i></span>
    <span class="intro-hud-label is-tr" data-intro-phase>01 / INIT</span>
    <span class="intro-hud-label is-bl" data-intro-coord>X 000.0&nbsp;&nbsp;Y 000.0</span>
  </div>
  <span class="intro-progress" data-intro-progress aria-hidden="true"></span>
  <p class="intro-sr" aria-live="polite">正在播放开场动画：Stay cool. See clearly. Keep aiming. 冷静观察，持续瞄准。按 Esc 或“跳过”按钮可直接进入首页。</p>
  <button type="button" class="intro-skip mono" data-intro-skip>跳过 <span>Skip</span></button>
</div>
<script>
  import { bootIntro } from '../../lib/intro/boot';
  bootIntro();
</script>
