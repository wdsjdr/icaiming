---
import { petConfig } from '../lib/pet/config';
const config = petConfig({ local: process.env.SITE_PET_LOCAL === '1', ui: import.meta.env.DEV, base: import.meta.env.PUBLIC_PET_ASSET_BASE_URL });
---
<aside class="site-pet no-print" data-site-pet data-state={config.enabled ? 'manual' : 'unconfigured'} data-mode="collapsed" data-config={JSON.stringify(config)} aria-label="站宠">
  <span class="pet-safe" data-pet-safe aria-hidden="true"></span>
  <div class="pet-stage" data-pet-stage hidden>
    <button type="button" class="pet-ball" data-pet-ball aria-label="展开站宠，可拖动" aria-describedby="pet-controls-help"><img src="/pet/avatar.webp" width="128" height="128" alt="" draggable="false" /></button>
    <button type="button" class="pet-touch" data-pet-touch aria-label="和站宠打招呼" aria-describedby="pet-controls-help" hidden>
      <span class="pet-canvas" aria-hidden="true">
        <img class="pet-placeholder" data-pet-placeholder src="/pet/idle.webp" width="640" height="360" alt="" draggable="false" />
        <video data-pet-video muted playsinline preload="none" disablepictureinpicture hidden></video>
        <video data-pet-video muted playsinline preload="none" disablepictureinpicture hidden></video>
      </span>
    </button>
    <button type="button" class="pet-drag" data-pet-drag aria-label="拖动站宠" title="拖动站宠（方向键移动，Shift + 方向键加速）" aria-describedby="pet-controls-help" hidden><svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M14 2 2 6.5 9 13.5Z"/></svg></button>
    <button type="button" class="pet-collapse" data-pet-collapse aria-label="收起为悬浮球" title="收起为悬浮球（Escape）" hidden><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m7 10 5 5 5-5"/></svg></button>
    <button type="button" class="pet-info-btn" data-pet-info aria-label="站宠说明与来源" aria-expanded="false" aria-controls="pet-info-bubble" hidden><span aria-hidden="true">i</span></button>
    <div class="pet-bubble" id="pet-info-bubble" data-pet-bubble role="dialog" aria-modal="false" aria-labelledby="pet-info-title" hidden>
      <p class="pet-bubble-title" id="pet-info-title"><strong>站宠说明与来源</strong></p>
      <p>形象原型：<a href="https://space.bilibili.com/4456176" target="_blank" rel="noopener noreferrer">@上善无形</a>、<a href="https://space.bilibili.com/4168597" target="_blank" rel="noopener noreferrer">@ZipZipPipe</a>、<a href="https://space.bilibili.com/23315338" target="_blank" rel="noopener noreferrer">@这个刀子真甜</a>。同人二创，CC BY-NC-SA 4.0；与 DeepSeek 官方无关，非合作、非商用。</p>
      <p>动画来自 <a href="https://github.com/PC2005-cloud/dsh-pet" target="_blank" rel="noopener noreferrer">PC2005-cloud / dsh-pet</a>（0.3.7）；适配代码 MIT，素材禁止商用。<a href="/legal/notices#article-5">完整说明</a></p>
      <button type="button" class="pet-bubble-close" data-pet-bubble-close aria-label="关闭说明">×</button>
    </div>
  </div>
  <span id="pet-controls-help" class="pet-sr">拖动悬浮球或右上角小三角可调整位置；聚焦后用方向键移动 10px，Shift + 方向键移动 40px，Escape 收起。</span>
  <span class="pet-sr" data-pet-status role="status" aria-live="polite"></span>
</aside>
<script>import { initPet } from '../lib/pet/runtime'; initPet();</script>
<style>
  [hidden] { display: none !important; }
  .pet-safe { position: fixed; visibility: hidden; pointer-events: none; padding: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left); }
  .pet-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  .pet-stage { position: fixed; z-index: 4; width: 0; height: 0; pointer-events: none; }
  .pet-ball, .pet-touch, .pet-drag, .pet-collapse, .pet-info-btn { position: absolute; padding: 0; color: var(--ink); pointer-events: auto; user-select: none; -webkit-user-select: none; }
  .pet-ball, .pet-drag { cursor: grab; touch-action: none; }
  .pet-ball { width: var(--pet-ball-size, 48px); height: var(--pet-ball-size, 48px); left: calc(var(--pet-ball-size, 48px) / -2); top: calc(-1 * var(--pet-ball-size, 48px)); border-radius: 50%; border: 1px solid var(--line); background: var(--surface); overflow: hidden; }
  .pet-ball img { width: 100%; height: 100%; object-fit: contain; pointer-events: none; }
  .pet-touch { left: calc(-120px * var(--pet-scale)); top: calc(-280px * var(--pet-scale)); width: calc(240px * var(--pet-scale)); height: calc(285px * var(--pet-scale)); border: 0; background: transparent; overflow: visible; cursor: pointer; touch-action: manipulation; }
  .pet-canvas { position: absolute; left: calc(-200px * var(--pet-scale)); top: calc(-50px * var(--pet-scale)); width: var(--pet-canvas-width); height: var(--pet-canvas-height); pointer-events: none; }
  video, .pet-placeholder { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; pointer-events: none; max-width: none; }
  .pet-drag, .pet-collapse { left: calc(120px * var(--pet-scale)); width: 44px; height: 44px; display: grid; place-items: center; }
  .pet-drag { top: calc(-280px * var(--pet-scale)); border: 0; background: transparent; border-radius: var(--radius); }
  .pet-drag svg { width: 16px; height: 16px; filter: drop-shadow(0 0 1px var(--surface)); }
  .pet-collapse { top: calc(-280px * var(--pet-scale) + 48px); border-radius: 50%; background: var(--surface); border: 1px solid var(--line); cursor: pointer; touch-action: manipulation; }
  .pet-collapse svg { width: 22px; height: 22px; }
  .pet-info-btn { left: calc(var(--pet-ball-size, 48px) / 2 + 8px); top: calc(-0.5 * var(--pet-ball-size, 48px) - 12px); width: 24px; height: 24px; min-height: 24px; aspect-ratio: 1; border-radius: 50%; border: 1px solid var(--line); background: var(--surface); color: var(--ink); font: 600 12px/1 ui-sans-serif, system-ui, sans-serif; display: grid; place-items: center; pointer-events: auto; cursor: pointer; padding: 0; }
  .pet-bubble { position: absolute; width: min(260px, calc(100vw - 16px)); background: var(--surface); color: var(--ink); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: 0 8px 24px rgb(0 0 0 / .12); padding: 12px 32px 12px 12px; font-size: 12px; line-height: 1.55; pointer-events: auto; z-index: 5; }
  .pet-bubble p { margin: 0 0 8px; }
  .pet-bubble p:last-of-type { margin-bottom: 0; }
  .pet-bubble a { text-decoration: underline; overflow-wrap: anywhere; }
  .pet-bubble-close { position: absolute; top: 2px; right: 2px; width: 28px; height: 28px; border: 0; background: transparent; color: var(--ink); font-size: 18px; line-height: 1; cursor: pointer; border-radius: 50%; }
  .pet-ball:focus-visible, .pet-touch:focus-visible, .pet-drag:focus-visible, .pet-collapse:focus-visible, .pet-info-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  [data-dragging] .pet-ball, [data-dragging] .pet-drag { cursor: grabbing; }
  .pet-touch[data-feedback] { outline: 1px dotted var(--accent); outline-offset: 2px; }
  @media print { .site-pet { display: none !important; } }
</style>
