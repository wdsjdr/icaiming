---
import PageLayout from '../../layouts/PageLayout.astro';
---
<PageLayout title="慢慢记录" eyebrow="01 / JOURNAL" english="Journal" description="写下过程，也留住想法。一些开发笔记，一些生活中的观察。" section="blog">
  <section data-blog><div class="search-row"><div class="filters" data-post-filters aria-label="按标签筛选文章"></div><label class="search-field"><span class="eyebrow">查找记录</span><input data-post-search type="search" placeholder="搜索标题、摘要或标签…" aria-label="搜索文章" /></label></div><p data-post-count class="eyebrow" aria-live="polite"></p><div data-post-list class="post-grid" aria-live="polite"><p class="loading">正在翻开记录…</p></div></section>
</PageLayout>
