---
import PageLayout from '../layouts/PageLayout.astro';
---
<PageLayout title="个人履历" eyebrow="BACKGROUND & EXPERIENCE" english="Résumé" description="经历、技能与正在做的事。这里从独立内容仓库读取结构化资料。" section="resume">
  <div data-resume aria-live="polite"><p class="loading">正在读取履历…</p></div>
  <div class="resume-actions no-print"><button class="button secondary" data-print>打印本页 ↗</button><a href="/about#contact" class="small-link">联系我 →</a></div>
</PageLayout>
<style>
  [data-resume] { max-width: 780px; }[data-resume] :global(h2) { font-size: 24px; font-weight: 500; }[data-resume] :global(.resume-block) { margin-top: 36px; padding-top: 26px; border-top: 1px solid var(--line); }[data-resume] :global(.timeline-item) { border-left: 1px solid var(--line); padding: 0 0 25px 24px; }[data-resume] :global(.timeline-item p) { color: var(--muted); }[data-resume] :global(.resume-summary) { color: var(--muted); font-size: 17px; }[data-resume] :global(h3) { font-size: 18px; }.resume-actions { display: flex; gap: 24px; margin-top: 35px; }
</style>
