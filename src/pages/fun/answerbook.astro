---
import PageLayout from '../../layouts/PageLayout.astro';
---
<PageLayout title="答案之书" eyebrow="PLAY / ANSWER BOOK" english="Ask" description="写下一个问题，翻到随机的一页。未必有用，但值得看一眼。" section="fun">
  <div class="answerbook">
    <form class="answerbook-form" data-answerbook-form>
      <label class="eyebrow" for="answerbook-q">你的问题</label>
      <div class="answerbook-row">
        <input id="answerbook-q" name="q" type="text" maxlength="100" autocomplete="off" placeholder="比如：今天会有好运气吗？" />
        <button class="button" type="submit">翻开一页 ↗</button>
      </div>
      <p class="answerbook-status mono" data-answerbook-status aria-live="polite"></p>
      <p class="answerbook-privacy">问题会经本站服务器转发至第三方接口 UAPI 获取答案，本站不保存。请勿输入个人信息。<a class="inline-link" href="/legal/privacy#article-3">隐私政策</a></p>
    </form>
    <div class="answerbook-page">
      <div class="answerbook-head"><span class="answerbook-mark mono">IC / ANSWER</span></div>
      <div class="answerbook-body"><p data-answerbook-answer class="answerbook-answer">写下问题，答案会出现在这里。</p></div>
    </div>
  </div>
  <p class="lab-note mono">RANDOM ANSWERS. NO GUARANTEES.</p>
</PageLayout>
<style>
  .answerbook { display: grid; gap: 36px; max-width: 760px; }
  .answerbook-form label { display: block; margin-bottom: 14px; margin-top: 0; }
  .answerbook-row { display: flex; gap: 12px; flex-wrap: wrap; }
  .answerbook-row input { flex: 1; min-width: 200px; }
  .answerbook-row .button { white-space: nowrap; font-weight: 500; }
  .answerbook-status { margin: 14px 0 0; font-size: 11px; color: var(--muted); }
  .answerbook-status:empty { display: none; }
  .answerbook-privacy { margin: 14px 0 0; font-size: 12px; line-height: 1.8; color: var(--muted); }
  .answerbook-privacy .inline-link { text-underline-offset: 3px; margin-left: 4px; }
  .answerbook-page { border: 1px solid var(--line); border-radius: var(--radius); background: var(--soft); min-height: 260px; display: flex; flex-direction: column; }
  .answerbook-head { display: flex; align-items: center; padding: 16px 32px; border-bottom: 1px solid var(--line); }
  .answerbook-mark { font-size: 10px; letter-spacing: .12em; color: var(--muted); }
  .answerbook-body { flex: 1; display: flex; align-items: center; padding: 44px 40px; }
  .answerbook-answer { margin: 0; font-family: 'Songti SC', 'SimSun', 'STSong', 'Noto Serif CJK SC', serif; font-size: clamp(24px, 3.2vw, 36px); line-height: 1.6; letter-spacing: .01em; transition: opacity .3s; }
  .answerbook-answer.is-thinking { opacity: .35; }
  .answerbook-answer.is-revealed { color: var(--accent); }
  .lab-note { margin: 40px 0 0; color: var(--muted); font-size: 10px; letter-spacing: .08em; }
  @media(max-width: 750px) {
    .answerbook-head { padding: 14px 22px; }
    .answerbook-body { padding: 32px 24px; }
  }
</style>
